# Copiez ce fichier en « .env » et collez votre clé secrète Stripe.
# Elle se trouve dans le tableau de bord Stripe → Développeurs → Clés d'API.
# Utilisez d'abord la clé de TEST (sk_test_...) pour essayer sans encaisser de vrai argent.
STRIPE_SECRET_KEY=sk_test_votre_cle_ici

# Email de confirmation de demande de dossier PFAS (Resend).
# Créez un compte sur resend.com, vérifiez le domaine aquelio.eu (DNS SPF/DKIM
# fournis par Resend, à ajouter chez votre hébergeur DNS), puis créez une clé API.
# Sans domaine vérifié, seule l'adresse onboarding@resend.dev fonctionne et
# Resend peut restreindre les destinataires à votre propre adresse de test.
RESEND_API_KEY=re_votre_cle_ici
EMAIL_FROM=Aquelio <hello@aquelio.eu>

# URL publique du site — sert à construire le lien du dossier dans l'email.
SITE_URL=https://aquelio.eu

# Jeton d'export des demandes (code postal + email) en CSV :
#   /api/export.csv?token=...
# Sans jeton défini, la route répond 404 — elle n'est jamais ouverte par défaut.
EXPORT_TOKEN=

# Port du serveur (optionnel).
PORT=4173
